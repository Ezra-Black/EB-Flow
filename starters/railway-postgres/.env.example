# Copy into Railway service variables (or local .env — never commit secrets).

DATABASE_URL=postgresql://user:pass@host:5432/railway
WORKER_ID=ingress-1
DEBOUNCE_MS=10000

# Optional: if you wake workers via HTTP instead of LISTEN/NOTIFY
# EBFLOW_WEBHOOK_SECRET=replace-me
# EBFLOW_WEBHOOK_URL=https://your-worker.up.railway.app/hooks/ebflow
